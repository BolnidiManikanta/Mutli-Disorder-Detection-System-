# ================================================================
#  NeuroScan AI — Server Environment Variables
#  Copy this to .env and fill in your values
#  DO NOT commit .env to git
# ================================================================

# ── MongoDB ──────────────────────────────────────────────────
# Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017

# MongoDB Atlas (cloud) — uncomment and use this instead:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name
DB_NAME=neuroscan

# ── Server ───────────────────────────────────────────────────
PORT=3001

# Frontend URL (for CORS) — set to your deployed frontend URL in production
FRONTEND_URL=http://127.0.0.1:5500

# ── Firebase Admin (for verifying user tokens) ───────────────
# Option A: Paste your service account JSON as a single-line string
# Get from: Firebase Console → Project Settings → Service accounts → Generate new private key
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"..."}

# Option B: Path to service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# ── DEV MODE ─────────────────────────────────────────────────
# If neither FIREBASE_SERVICE_ACCOUNT nor GOOGLE_APPLICATION_CREDENTIALS is set,
# the server runs in DEV mode and accepts X-Dev-UID header for auth (no token needed).
# NEVER use DEV mode in production.
